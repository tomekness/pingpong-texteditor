# Admin panel password
ADMIN_PASSWORD=changeme

# LLM backend — any OpenAI-compatible API
# Examples:
#   Ollama (local):       http://localhost:11434/v1
#   LM Studio (local):    http://localhost:1234/v1
#   OpenWebUI (local):    http://localhost:3000/openai
#   Hugging Face TGI:     https://api-inference.huggingface.co/models/<model>/v1
#   OpenAI:               https://api.openai.com/v1
LLM_BASE_URL=http://localhost:11434/v1

# API key for the LLM backend (leave empty if not required, e.g. local Ollama)
LLM_API_KEY=your-api-key-here

# Model name as expected by the backend
# Examples: llama3.2, mistral, gpt-4o, meta-llama/Meta-Llama-3-8B-Instruct
LLM_MODEL=llama3.2
